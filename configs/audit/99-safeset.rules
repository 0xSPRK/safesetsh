# Managed by safeset (safesetsh). Audit rules based on CIS Level 1.
# Loaded via augenrules --load. Note: `-e 2` (immutable) is intentionally NOT
# set so that safeset and the administrator can update rules without reboot.

## --- Identity / authentication files ------------------------------------
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/pam.d/ -p wa -k pam
-w /etc/nsswitch.conf -p wa -k nsswitch

## --- sudoers ------------------------------------------------------------
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers

## --- SSH ----------------------------------------------------------------
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd

## --- Privilege escalation ----------------------------------------------
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -F auid>=1000 -F auid!=-1 -k privilege
-a always,exit -F arch=b32 -S setuid -S setgid -S setreuid -S setregid -F auid>=1000 -F auid!=-1 -k privilege

## --- Kernel modules -----------------------------------------------------
-a always,exit -F arch=b64 -S init_module -S finit_module -S delete_module -k modules
-a always,exit -F arch=b32 -S init_module -S finit_module -S delete_module -k modules
-w /sbin/insmod -p x -k modules
-w /sbin/rmmod -p x -k modules
-w /sbin/modprobe -p x -k modules
-w /usr/bin/kmod -p x -k modules

## --- Time changes -------------------------------------------------------
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -k time-change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S clock_settime -k time-change
-w /etc/localtime -p wa -k time-change
-w /etc/chrony/chrony.conf -p wa -k time-change

## --- System / network configuration ------------------------------------
-w /etc/hostname -p wa -k system
-w /etc/hosts -p wa -k system
-w /etc/issue -p wa -k system
-w /etc/issue.net -p wa -k system
-w /etc/motd -p wa -k system
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/at.allow -p wa -k cron
-w /etc/at.deny -p wa -k cron
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron

## --- Systemd units ------------------------------------------------------
-w /etc/systemd/ -p wa -k systemd
-w /lib/systemd/system/ -p wa -k systemd
-w /usr/lib/systemd/system/ -p wa -k systemd

## --- Firewall / nftables ------------------------------------------------
-w /etc/nftables.conf -p wa -k firewall
-w /etc/nftables.d/ -p wa -k firewall
-w /etc/fail2ban/ -p wa -k firewall

## --- Mounts -------------------------------------------------------------
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=-1 -k mounts
-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=-1 -k mounts

## --- Logins / sessions --------------------------------------------------
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/log/tallylog -p wa -k logins
