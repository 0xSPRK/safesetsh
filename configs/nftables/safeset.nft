#!/usr/sbin/nft -f
# Managed by safeset (safesetsh). Do not edit by hand — replaced on each run.
# Atomic replace: the safeset.sh module deletes the inet table "safeset"
# (same batch) when it already exists, then applies this file.

table inet safeset {
	set admin4 {
		type ipv4_addr
		flags interval
@ADMIN4_ELEMENTS@
	}
	set admin6 {
		type ipv6_addr
		flags interval
@ADMIN6_ELEMENTS@
	}
	# NOTE: no `counter` here — kernel rejects dynset add + limit (EOPNOTSUPP)
	# on sets with the counter flag (Debian 12, nft 1.0.6).
	set throttle4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 30m
	}
	set throttle6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 30m
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop

		# Operator whitelist — keep yourself out of the ban path.
		ip saddr @admin4 accept
		ip6 saddr @admin6 accept

		# --- ICMP: rate-limited, no redirects (sysctl blocks those) ---
		ip protocol icmp icmp type echo-request limit rate 5/second burst 10 packets accept
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		ip protocol icmp drop
		ip6 nexthdr icmpv6 icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate 5/second burst 10 packets accept
		ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept

		# --- malformed / scan packets ---
		tcp flags & (fin|syn|rst|ack) == 0 counter log prefix "safeset-scan: " drop
		tcp flags & (fin|syn|rst|ack) == (fin|syn|rst|ack) counter log prefix "safeset-scan: " drop
		tcp flags & (fin|syn) == (fin|syn) counter log prefix "safeset-scan: " drop
		tcp flags & (syn|rst) == (syn|rst) counter log prefix "safeset-scan: " drop
		tcp flags & (fin|psh|urg) == (fin|psh|urg) counter log prefix "safeset-scan: " drop

		# --- connection flood: source goes into a 30m timeout ban set ---
		ct state new ip saddr @throttle4 counter drop
		ct state new ip6 saddr @throttle6 counter drop
		ct state new add @throttle4 { ip saddr limit rate over 80/second burst 120 packets }
		ct state new add @throttle6 { ip6 saddr limit rate over 80/second burst 120 packets }

		# --- SSH: per-source rate limit, then accept ---
		tcp dport @SSH_PORT@ ct state new meter ssh_rate4 { ip saddr limit rate over 15/second burst 25 packets } log prefix "safeset-scan: " drop
		tcp dport @SSH_PORT@ ct state new meter ssh_rate6 { ip6 saddr limit rate over 15/second burst 25 packets } drop
		tcp dport @SSH_PORT@ ct state new accept

		# --- explicitly allowed services (from --allow-ports) ---
		@ALLOW_RULES@

		# Everything else: drop (policy). Rate-limited log for visibility.
		limit rate 5/minute burst 10 packets log prefix "safeset-drop: " flags all
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
